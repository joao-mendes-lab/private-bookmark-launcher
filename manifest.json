{
  "manifest_version": 2,
  "name": "Private Bookmark Launcher",
  "version": "1.0.0",
  "description": "Browse your Firefox bookmarks, pick any combination from any folders, and open them all as tabs in the current window.",
  "permissions": ["bookmarks", "tabs"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Private Bookmark Launcher",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "incognito": "spanning"
}